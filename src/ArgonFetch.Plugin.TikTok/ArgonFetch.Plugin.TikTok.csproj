<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArgonFetch.Plugin.TikTok</AssemblyName>

    <!-- What the index publishes this build as. Raise it when the plugin changes. -->
    <PluginVersion>1.0.0</PluginVersion>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scrubbing is internal; its tests are the reason the titles come out readable. -->
    <InternalsVisibleTo Include="ArgonFetch.Plugin.TikTok.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced, never shipped: see the note in the Spotify plugin. -->
    <PackageReference Include="ArgonFetch.Abstractions" Version="1.0.1" ExcludeAssets="runtime" />
    <PackageReference Include="AngleSharp" Version="1.7.2" />
  </ItemGroup>

</Project>
