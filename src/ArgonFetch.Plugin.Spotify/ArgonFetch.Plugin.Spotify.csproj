<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArgonFetch.Plugin.Spotify</AssemblyName>

    <!-- What the index publishes this build as. Raise it when the plugin changes. -->
    <PluginVersion>1.0.0</PluginVersion>

    <!--
      Everything this plugin needs has to travel with it, since the host loads it from a folder
      rather than resolving it as a project reference.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The matcher's scoring is internal; its tests are the reason any of it is trustworthy. -->
    <InternalsVisibleTo Include="ArgonFetch.Plugin.Spotify.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" is not optional. The host loads the contract itself and hands this
      plugin types from its own copy; shipping a second copy would give this assembly a different
      ISourceProvider, and the load fails saying ISourceProvider cannot be cast to ISourceProvider.
    -->
    <PackageReference Include="ArgonFetch.Abstractions" Version="1.0.1" ExcludeAssets="runtime" />

    <!--
      Spotify serves no audio anyone can download, so the recording has to be found elsewhere.
      This is the search that finds it - and the reason it lives here rather than in ArgonFetch:
      it is the most volatile code in the project and it is of no use to any other source.
    -->
    <PackageReference Include="YouTubeMusicAPI" Version="3.0.11" />
    <PackageReference Include="AngleSharp" Version="1.7.2" />
  </ItemGroup>

</Project>
